# Database — PostgreSQL
# Local:    postgresql://postgres:postgres@localhost:5432/spark_savings
# Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/spark_savings?sslmode=require
# Supabase: postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spark_savings"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-secret-in-production"

# Stripe (get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
# Webhook secret: stripe listen --forward-to localhost:3000/api/webhooks/stripe (local dev)
# Production: create webhook at https://dashboard.stripe.com/webhooks → /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# Platform fee percentage
PLATFORM_FEE_PERCENT="15"

# Resend — transactional emails (password reset, notifications)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=""
# Use onboarding@resend.dev until you verify your own domain in Resend
EMAIL_FROM="Spark Savings <onboarding@resend.dev>"

# Optional: OpenAI key for enhanced AI triage (app works without it)
OPENAI_API_KEY=""
